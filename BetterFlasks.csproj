<Project Sdk="Microsoft.NET.Sdk" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- 核心项目设置 -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>Latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>

    <AssemblyName>BetterFlasks</AssemblyName>
    <RootNamespace>BetterFlasks</RootNamespace>
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <!-- 游戏路径配置 -->
  <PropertyGroup>
    <TheLongDarkPath>C:\Program Files (x86)\Steam\steamapps\common\TheLongDark\</TheLongDarkPath>
  </PropertyGroup>

  <!-- NuGet 包引用 -->
  <ItemGroup>
    <PackageReference Include="STBlade.Modding.TLD.Il2CppAssemblies.Windows" Version="2.51.0" />
    <PackageReference Include="STBlade.Modding.TLD.ModSettings" Version="1.9.0" />
  </ItemGroup>

  <!-- 全局 using 声明 -->
  <ItemGroup>
    <Using Include="System.Reflection" />
    <Using Include="System.Diagnostics.CodeAnalysis" />
    <Using Include="Il2Cpp" />
    <Using Include="HarmonyLib" />
    <Using Include="MelonLoader" />
    <Using Include="UnityEngine" />
    <Using Include="ModSettings" />
    <Using Include="Il2CppTLD.Gear" />
  </ItemGroup>

  <!-- SDK 风格项目会自动递归编译项目目录内的全部 .cs 文件。 -->

  <!-- 构建后自动复制到游戏 Mods 文件夹。 -->
  <Target
    Name="CopyModToGame"
    AfterTargets="Build"
    Condition="Exists('$(TheLongDarkPath)Mods')">
    <Copy
      SourceFiles="$(TargetPath)"
      DestinationFolder="$(TheLongDarkPath)Mods"
      SkipUnchangedFiles="true" />
    <Message
      Text="BetterFlasks.dll copied to $(TheLongDarkPath)Mods"
      Importance="high" />
  </Target>

</Project>
